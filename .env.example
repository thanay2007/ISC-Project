# Run python backend/setup_env.py to create .env with generated keys.
APP_SECRET_KEY=
ENCRYPTION_KEY=
DATABASE_URL=
PUBLIC_URL=http://localhost:3000
COOKIE_SECURE=false
DEMO_ENABLED=true
# Optional. Set both the key and a model available in your account.
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
# auto prefers PaddleOCR and falls back to Tesseract (if installed) and PDF text.
OCR_ENGINE=auto
TESSERACT_CMD=
# Run locally once with these set to bootstrap an administrator, then remove them.
ADMIN_EMAIL=
ADMIN_PASSWORD=
