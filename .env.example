# Run python backend/setup_env.py to create .env with generated keys.
APP_SECRET_KEY=
ENCRYPTION_KEY=
# Paste the Supabase Dashboard Session pooler URL here with the database password filled in.
DATABASE_URL=
PUBLIC_URL=http://localhost:3000
COOKIE_SECURE=false
DEMO_ENABLED=true
# Optional. Set both the key and a model available in your account.
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
# auto prefers PaddleOCR and falls back to Tesseract (if installed) and PDF text.
OCR_ENGINE=auto
TESSERACT_CMD=
# Clerk Dashboard API keys. The secret is used only by FastAPI.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# The verified email of the first Clerk administrator.
ADMIN_EMAIL=
# Optional password for existing API-based administrator setup.
ADMIN_PASSWORD=
